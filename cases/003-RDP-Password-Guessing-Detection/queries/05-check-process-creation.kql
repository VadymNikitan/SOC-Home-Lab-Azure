SecurityEvent
| where TimeGenerated between (
    datetime(2026-09-17T18:33:57Z) .. datetime(2026-09-17T18:45:00Z)
)
| where Computer == "CORP-WS-001"
| where EventID == 4688
| project
    TimeGenerated,
    Account,
    NewProcessName,
    Process,
    CommandLine,
    ParentProcessName
| order by TimeGenerated asc
