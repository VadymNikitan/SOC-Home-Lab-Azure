SecurityEvent
| where TimeGenerated between (
    datetime(2026-09-17T18:33:57Z) .. datetime(2026-09-17T19:00:00Z)
)
| where Computer == "CORP-WS-001"
| where EventID in (
    4720, 4722, 4724, 4725, 4726,
    4728, 4729, 4732, 4733, 4738,
    4740
)
| project
    TimeGenerated,
    EventID,
    Activity,
    Account,
    TargetAccount,
    IpAddress
| order by TimeGenerated asc
