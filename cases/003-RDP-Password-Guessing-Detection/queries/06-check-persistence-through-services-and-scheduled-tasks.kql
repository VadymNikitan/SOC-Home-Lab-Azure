SecurityEvent
| where TimeGenerated between (
    datetime(2026-09-17T18:33:57Z) .. datetime(2026-09-17T19:00:00Z)
)
| where Computer == "CORP-WS-001"
| where EventID in (
    4697, 4698, 4699, 4700, 4701, 4702
)
| project
    TimeGenerated,
    EventID,
    Activity,
    Account,
    IpAddress
| order by TimeGenerated asc
