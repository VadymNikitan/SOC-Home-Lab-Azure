SecurityEvent
| where TimeGenerated between (
    datetime(2026-09-17T18:30:00Z) .. datetime(2026-09-17T19:00:00Z)
)
| where Computer == "CORP-WS-001"
| where EventID == 4624
| where Account contains "Ragnar"
| where IpAddress == "10.0.1.11"
| project
    TimeGenerated,
    EventID,
    LogonType,
    Account,
    IpAddress,
    WorkstationName,
    LogonId
| order by TimeGenerated asc
