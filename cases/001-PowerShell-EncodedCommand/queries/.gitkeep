SecurityEvent
| where TimeGenerated > ago(4h)
| where EventID == 1
| where CommandLine contains "powershell.exe"
| where CommandLine contains "-e"
| project TimeGenerated, Computer, CommandLine

SecurityEvent
| where EventSourceName == "Microsoft-Windows-Sysmon"
| where EventID == 3
| where Computer == "Honeypot"
| where TimeGenerated > ago(1h)

SecurityEvent
| where EventSourceName == "Microsoft-Windows-Sysmon"
| where EventID == 3
| where Computer == "Honeypot"
| where TimeGenerated between(datetime(2026-07-25 10:55:00) .. datetime(2026-07-25 11:05:00))


SecurityEvent
| where EventSourceName == "Microsoft-Windows-Sysmon"
| where EventID == 3
| where Computer == "Honeypot"
| where EventData contains "powershell"
| where TimeGenerated between(datetime(2026-07-25 10:55:00) .. datetime(2026-07-25 11:05:00))


SecurityEvent
| where EventSourceName == "Microsoft-Windows-Sysmon"
| where EventID == 11
| where Computer == "Honeypot"
| where TimeGenerated between(datetime(2026-07-25 10:55:00) .. datetime(2026-07-25 11:05:00))
