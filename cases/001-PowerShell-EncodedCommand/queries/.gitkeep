SecurityEvent
| where TimeGenerated > ago(4h)
| where EventID == 1
| where CommandLine contains "powershell.exe"
| where CommandLine contains "-e"
| project TimeGenerated, Computer, Account, CommandLine, ParentProcessName, EventData
| order by TimeGenerated desc

SecurityEvent
| where EventID == 3
| where EventData contains "{ff02a448-22ce-6a6b-fb00-000000001400}"

SecurityEvent
| where EventID == 11
| where EventData contains "{ff02a448-22ce-6a6b-fb00-000000001400}"



SecurityEvent
| where EventSourceName == "Microsoft-Windows-Sysmon"
| where EventID == 1
| where CommandLine has_any ("-enc", "-EncodedCommand", " -e ")
| project TimeGenerated, Computer, Account, CommandLine, EventData
